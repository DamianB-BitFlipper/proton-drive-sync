# Copy this file to .env.staging and fill in a unique local encryption key.
# Do not commit .env.staging.
KEYRING_PASSWORD=replace-with-a-random-value
TZ=UTC
STAGING_DASHBOARD_PORT=4243
# Host directory to expose inside the container as /data/staging.
# Set this to an absolute path if you want to test an existing directory.
STAGING_SYNC_DIR=../.staging-sync
